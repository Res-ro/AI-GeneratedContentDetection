# Copy to .env (git-ignored) only if you need to change a default.
# No secrets are required by this application.

# Exact origin(s) of the React front end, comma-separated. "*" is rejected.
AIDETECT_CORS_ORIGINS=http://localhost:5173

# Rate limit per client IP
AIDETECT_RATE_LIMIT_REQUESTS=20
AIDETECT_RATE_LIMIT_WINDOW_SECONDS=60

# Set to false in production to hide /docs and /openapi.json
AIDETECT_ENABLE_DOCS=true

# Only for recording the "attack works without the defence" part of the video:
# AIDETECT_INFERENCE_GUARD_ENABLED=false   # DoS defence off
# AIDETECT_NORMALISE_INPUT=false           # Unicode-evasion defence off
